{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "server/db/*.sql" },
    "api/health.js": { "maxDuration": 30, "includeFiles": "server/db/*.sql" },
    "api/cron/ops.js": { "maxDuration": 60, "includeFiles": "server/db/*.sql" }
  },
  "rewrites": [
    { "source": "/api/:wfhpath((?!health$|index$|cron/).*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ],
  "crons": [
    { "path": "/api/cron/ops", "schedule": "0 3 * * *" }
  ]
}
